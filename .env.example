# Remote-render secrets. Copy to .env and fill in. .env is gitignored; never
# commit real secrets. See scripts/render-remote.sh.

# RunPod API key (RunPod console -> Settings -> API Keys).
RUNPOD_API_KEY=

# Backblaze B2 application key (B2 console -> App Keys), consumed by rclone's
# native b2 backend as the remote "b2". No rclone.conf needed.
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=      # B2 keyID
RCLONE_CONFIG_B2_KEY=          # B2 applicationKey
B2_BUCKET=                     # B2 bucket name (e.g. gr-raytracer)
